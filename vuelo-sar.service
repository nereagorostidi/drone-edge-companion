[Unit]
Description=Captura y envio MQTT de la telemetria de vuelo (SAR)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nerea
WorkingDirectory=/home/nerea/drone-edge-companion
Environment=PYTHONUNBUFFERED=1
# Sin --fake: vuelo.py lee MAVLink real por defecto (Pixhawk o Mission
# Planner en SITL). Si el autopiloto/SITL deja de estar disponible, el
# servicio se queda esperando el heartbeat MAVLink indefinidamente; para
# volver a datos simulados, añadir --fake aquí.
ExecStart=/home/nerea/drone-edge-companion/venv/bin/python -u /home/nerea/drone-edge-companion/vuelo.py -i 1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
