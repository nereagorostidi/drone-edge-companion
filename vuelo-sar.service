[Unit]
Description=Captura y envio MQTT de la telemetria de vuelo (SAR)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nerea
WorkingDirectory=/home/nerea/drone-edge-companion
Environment=PYTHONUNBUFFERED=1
# --fake: quitar este flag en cuanto el Pixhawk (o el SITL) esté disponible;
# sin él, vuelo.py se queda esperando el heartbeat MAVLink indefinidamente.
ExecStart=/home/nerea/bme680-env/bin/python -u /home/nerea/drone-edge-companion/vuelo.py -i 1 --fake
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
