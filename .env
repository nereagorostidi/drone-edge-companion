# =====================================================================
#  Configuración del nodo edge — proceso AMBIENTAL (sensor.py)
#  Sistema SAR basado en dron
# =====================================================================
# IMPORTANTE: este fichero NO debe subirse a git (contiene tu
# infraestructura). Añádelo a .gitignore y versiona en su lugar un
# .env.example con las claves pero sin los valores reales.

# --- Identificación del dron ---
# De aquí se construyen el topic (sar/<DRON_ID>/ambiental) y el
# client_id (<DRON_ID>-ambiental). Para desplegar en otra unidad,
# basta con cambiar este único valor.
DRON_ID=dron02

# --- Broker MQTT (servidor EC2) ---
# IP o dominio del broker. Si usas un subdominio para MQTT, recuerda
# que en Cloudflare debe ir en modo DNS-only (nube gris), no proxy,
# porque MQTT no es HTTP.
EC2_HOST=51.48.220.143
MQTT_PORT=1883

# --- Fichero de posición (vuelo -> deteccion) ---
# Opcional: ruta del posicion_actual.json que vuelo.py escribe y que
# deteccion.py leerá. Ambos usan el mismo valor por defecto, así que solo
# hace falta descomentarlo si quieres cambiar la ruta.

POS_FILE=./posicion_actual.json

# --- Reenvío ---
# Número de filas que se intentan enviar por ciclo.
LOTE=50 