[Unit]
Description=Deteccion de personas YOLO sobre video (SAR)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nerea
WorkingDirectory=/home/nerea/drone-edge-companion
Environment=PYTHONUNBUFFERED=1
# Por defecto usa la camara en vivo (indice 0); no arranca solo, se queda
# esperando 'start_recording' del panel (ver README). Para procesar un
# video de fichero en su lugar, sustituir "--camera 0" por su ruta.
# --preview false es obligatorio aqui: no hay pantalla en un servicio systemd.
# --runtime hef: inferencia en el acelerador Hailo-8 del AI Kit (el motor mas
# rapido: ~34 ms/frame frente a ~120 ms de NCNN en la CPU). Requiere el Hailo
# conectado, HailoRT instalado y weights/best_hailo_model/ (si falta algo de
# eso, el servicio falla al arrancar con un aviso claro y systemd lo reintenta).
# Para volver a la CPU: sustituir por "--runtime ncnn".
ExecStart=/home/nerea/drone-edge-companion/venv/bin/python -u /home/nerea/drone-edge-companion/deteccion.py --camera 0 --preview false --runtime hef
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
