[Unit]
Description=Deteccion de personas YOLO sobre video (SAR)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nerea
WorkingDirectory=/home/nerea/drone-edge-companion
Environment=PYTHONUNBUFFERED=1
# Editar la ruta del video antes de instalar: no hay pantalla en un
# servicio systemd, por eso --preview false es obligatorio aqui.
ExecStart=/home/nerea/bme680-env/bin/python -u /home/nerea/drone-edge-companion/deteccion.py /home/nerea/drone-edge-companion/samples/vuelo1.mp4 --preview false
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
