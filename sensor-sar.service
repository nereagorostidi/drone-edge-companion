[Unit]
Description=Captura y envio MQTT del sensor BME680 (SAR)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nerea
WorkingDirectory=/home/nerea/drone-edge-companion
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/nerea/drone-edge-companion/venv/bin/python -u /home/nerea/drone-edge-companion/sensor.py -i 30
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
