# Broker MQTT en el servidor cloud
EC2_HOST=your_ec2_ip_or_domain_here
MQTT_PORT=1883
MQTT_TOPIC=casa/salon/sensores

# Buffer local (store-and-forward)
LOTE=50

DRON_ID=XXX
POS_FILE=./posicion_actual.json

# vuelo.py: cadena de conexión MAVLink para leer telemetría real (Pixhawk o
# Mission Planner en SITL). No se usa si vuelo.py se lanza con --fake.
# Debe ser un puerto distinto al de MAVLINK_CONN (receptor.py) para que
# ambos procesos puedan hablar con el autopiloto a la vez.
MAVLINK_CONN_VUELO=udpin:0.0.0.0:14552

# receptor.py usa sus propias variables (no DRON_ID/EC2_HOST). Deben
# identificar al MISMO dron y broker que arriba, o los comandos de vuelo
# (arm/disarm...) nunca le llegarán. El valor debe coincidir exactamente
# con uno de los DRONES_VALIDOS que espera api.py (p. ej. "dron-01").
DRONE_ID=XXX
MQTT_BROKER=your_ec2_ip_or_domain_here

# deteccion.py --stream: streaming en directo hacia MediaMTX (RTSP, vía
# ffmpeg). STREAM_HOST/USER/PASS son obligatorias para que se active; sin
# ellas (o sin ffmpeg instalado), se desactiva sola con un aviso y
# deteccion.py sigue funcionando igual (vídeo local + alertas).
STREAM_HOST=your_mediamtx_host_here
STREAM_USER=XXX
STREAM_PASS=XXX
STREAM_PATH=dron_live
STREAM_ANCHO=640
STREAM_ALTO=360
STREAM_FPS=12

# deteccion.py: carpetas de salida (vídeos anotados y fotos de alerta).
# Opcionales — sin ellas usa results/videos y results/fotos, dentro del
# propio repo. Útil para cuando se monte almacenamiento aparte (p. ej. una
# tarjeta SD/USB en /media/...) sin tener que tocar código.
# VIDEOS_DIR=/media/dron/videos
# FOTOS_DIR=/media/dron/fotos